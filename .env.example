# NovaStream TV - configuracion NO secreta.
# Copia a .env solo si tu flujo de trabajo lo requiere; la app NO lee .env
# en el televisor (webOS no tiene env vars para web apps). Estos valores
# son los mismos que puedes cambiar en Ajustes dentro de la TV.

# URL del JS service opcional (proxy sin CORS). Vacio = deteccion automatica.
NOVASTREAM_SERVICE_URL=

# Tiempo maximo de una peticion de red (ms)
NOVASTREAM_HTTP_TIMEOUT=12000

# Numero maximo de peticiones simultaneas
NOVASTREAM_HTTP_CONCURRENCY=4

# Tiempo maximo de espera del primer fotograma del reproductor (ms)
NOVASTREAM_PLAYER_TIMEOUT=15000

# Activa el reproductor alternativo (Shaka/MSE) si el proveedor lo exige.
# Requiere copiar vendor/shaka-player.compiled.js en el paquete.
NOVASTREAM_ENABLE_MSE=false

# Origenes permitidos para listas/EPG. Vacio = solo http/https.
NOVASTREAM_ALLOWED_SCHEMES=http,https
